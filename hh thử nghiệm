local function getMerchantPosition()
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj and (obj:IsA("Model") or obj:IsA("Part")) then
            local objName = string.lower(obj.Name)
            if objName:find("fish") and objName:find("merchant") then
                local primaryPart = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChildOfClass("Part")) or obj
                if primaryPart and primaryPart:IsA("BasePart") then return primaryPart.Position end
            end
        end
    end
    return Vector3.new(1263.48, 27.71, -349.61)
end

local function clickBtn(keys)
    local inset = GuiService:GetGuiInset()
    for _, obj in pairs(PlayerGui:GetDescendants()) do
        if (obj:IsA("TextButton") or obj:IsA("TextLabel")) and obj.Visible then
            local txt = string.lower(obj.Text or "")
            for _, kw in ipairs(keys) do
                if txt:find(kw) then
                    local pos, sz = obj.AbsolutePosition, obj.AbsoluteSize
                    local cx, cy = pos.X + sz.X/2 + inset.X, pos.Y + sz.Y/2 + inset.Y
                    VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, true, game, 1)
                    task.wait(0.05)
                    VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, game, 1)
                    return true
                end
            end
        end
    end
    return false
end

local function findActiveFishTarget()
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj and (obj:IsA("Model") or obj:IsA("Part")) then
            local name = string.lower(obj.Name)
            if name:find("fish") or name:find("catch") or name:find("shark") or name:find("whale") or name:find("mob") then
                local part = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChildOfClass("Part")) or obj
                if part and part:IsA("BasePart") then
                    local char = LocalPlayer.Character
                    local root = char and char:FindFirstChild("HumanoidRootPart")
                    if root and (part.Position - root.Position).Magnitude < 40 then return part end
                end
            end
        end
    end
    return nil
end

