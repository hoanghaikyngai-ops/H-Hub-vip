local camKeys = {
    {0.00, V3(-60, 11, 34), V3(-40, 6.5, 0), false},
    {0.40, V3(-49, 8.5, 22), V3(-36, 6.8, 0), false},
    {0.50, V3(-45, 7.5, 17), V3(-32, 7.0, 0), false},
    {0.545, V3(-46, 7.5, 18), V3(-30, 7.2, 0), false},
    {0.62, V3(26, 11, 36), V3(28, 8, 0), true},     -- lia nhanh sang Sukuna
    {0.70, V3(22, 10, 30), V3(24, 8, 0), false},
    {0.74, V3(14, 9, 25), V3(14, 8, 0), false},
}
local function camAt(u)
    local n = #camKeys
    if u <= camKeys[1][1] then return camKeys[1][2], camKeys[1][3] end
    for i = 1, n - 1 do
        local a, b = camKeys[i], camKeys[i + 1]
        if u <= b[1] then
            local k = clamp01((u - a[1]) / (b[1] - a[1]))
            if b[4] then k = ease(k) end
            return a[2]:Lerp(b[2], k), a[3]:Lerp(b[3], k)
        end
    end
    return camKeys[n][2], camKeys[n][3]
end

