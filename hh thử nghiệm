task.spawn(function()
    while ScreenGui.Parent do
        task.wait(0.1)
        if isRunning then
            pcall(function()
                local char = LocalPlayer.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if not root or not hum then return end
                if not OriginalFishingSpotCFrame and not isSellingFish then OriginalFishingSpotCFrame = root.CFrame end

                if getFishToSellCount() >= maxFishCapacity and not isSellingFish then
                    isSellingFish = true
                    local vp = Camera.ViewportSize
                    VirtualInputManager:SendMouseButtonEvent(vp.X/2, vp.Y/2, 0, true, game, 1); task.wait(0.08)
                    VirtualInputManager:SendMouseButtonEvent(vp.X/2, vp.Y/2, 0, false, game, 1); task.wait(0.25)
                    root.Anchored = false; hum.WalkSpeed = 16; task.wait(0.05)

                    local dynamicMerchantPos = getMerchantPosition()
                    local safeTargetPos = dynamicMerchantPos - (CFrame.new(dynamicMerchantPos).LookVector * 3.5)
                    local dist = (root.Position - safeTargetPos).Magnitude
                    if merchantLockConnection then merchantLockConnection:Disconnect() end

                    merchantLockConnection = RunService.RenderStepped:Connect(function()
                        pcall(function()
                            local cc = LocalPlayer.Character
                            local cr = cc and cc:FindFirstChild("HumanoidRootPart")
                            local ch = cc and cc:FindFirstChildOfClass("Humanoid")
                            if cr and dynamicMerchantPos then
                                cr.Anchored = true; if ch then ch.WalkSpeed = 0 end
                                Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, dynamicMerchantPos)
                                cr.CFrame = CFrame.lookAt(cr.Position, Vector3.new(dynamicMerchantPos.X, cr.Position.Y, dynamicMerchantPos.Z))
                            end
                        end)
                    end)

                    local merchantTween = TweenService:Create(root, TweenInfo.new(dist / 55, Enum.EasingStyle.Linear), {CFrame = CFrame.new(safeTargetPos, dynamicMerchantPos)})
                    merchantTween:Play()
                    while merchantTween.PlaybackState == Enum.PlaybackState.Playing and isRunning do task.wait(0.05) end
                    root.CFrame = CFrame.new(safeTargetPos, dynamicMerchantPos); task.wait(0.3)

                    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game); task.wait(0.05)
                    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game); task.wait(0.5)

                    local initialFishCount = getFishToSellCount()
                    local sellStartTime = tick()
                    repeat
                        if not isRunning then break end
                        pcall(function() root.Anchored = true; hum.WalkSpeed = 0; root.CFrame = CFrame.new(safeTargetPos, dynamicMerchantPos) end)
                        clickBtn({"bán tất cả", "sell all", "bán", "sell"}); task.wait(0.25)
                        clickBtn({"xác nhận", "confirm", "đồng ý", "yes", "ok"}); task.wait(0.4)
                        if getFishToSellCount() == 0 or (initialFishCount - getFishToSellCount() > 0) then task.wait(0.3); break end
                    until (tick() - sellStartTime > 8) or not isRunning

                    task.wait(0.4)
                    local byeStartTime = tick()
                    repeat
                        if not isRunning then break end
                        pcall(function() root.Anchored = true; hum.WalkSpeed = 0 end)
                        if clickBtn({"tạm biệt", "tam biet", "goodbye", "bye", "thoát", "close", "đóng", "x"}) then task.wait(0.5); break end
                        task.wait(0.25)
                    until (tick() - byeStartTime > 4.0) or not isRunning

                    if merchantLockConnection then merchantLockConnection:Disconnect(); merchantLockConnection = nil end

                    if OriginalFishingSpotCFrame then
                        root.Anchored = false; hum.WalkSpeed = 16
                        local dBack = (root.Position - OriginalFishingSpotCFrame.Position).Magnitude
                        local backTween = TweenService:Create(root, TweenInfo.new(dBack / 55, Enum.EasingStyle.Linear), {CFrame = OriginalFishingSpotCFrame})
                        backTween:Play()
                        while backTween.PlaybackState == Enum.PlaybackState.Playing and isRunning do task.wait(0.05) end
                        root.CFrame = OriginalFishingSpotCFrame
                    end
                    isSellingFish = false
                end

                if not isRunning or isSellingFish or isFightingFish then return end
                if OriginalFishingSpotCFrame then root.CFrame = OriginalFishingSpotCFrame end
                root.Anchored = true; hum.WalkSpeed = 0

                local activeTool = char and char:FindFirstChildOfClass("Tool")
                local isHoldingRod = activeTool and (string.lower(activeTool.Name):find("rod") or string.lower(activeTool.Name):find("cần"))
                if not isHoldingRod then
                    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.One, false, game); task.wait(0.02)
                    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.One, false, game); task.wait(0.1)
                end

                if isRunning and not isSellingFish and not isFightingFish then
                    local vp = Camera.ViewportSize
                    if activeTool then pcall(function() activeTool:Activate() end) end
                    VirtualInputManager:SendMouseButtonEvent(vp.X/2, vp.Y/2 - 80, 0, true, game, 1)
                    local holdStart = tick()
                    while tick() - holdStart < 2.0 and isRunning and not isSellingFish and not isFightingFish do task.wait(0.05) end
                    VirtualInputManager:SendMouseButtonEvent(vp.X/2, vp.Y/2 - 80, 0, false, game, 1)
                    task.wait(0.05)
                end
            end)
        end
    end
end)

-- VÒNG LẶP RENDER: VIỀN NEON + THANH TIẾN TRÌNH + LẮC HÔNG
RunService.RenderStepped:Connect(function()
    pcall(function()
        updateHeadBillboard()

        local timeVal = tick() * 2
        local neonColor = Color3.fromRGB(
            math.floor(math.sin(timeVal) * 35 + 35),
            math.floor(math.sin(timeVal) * 110 + 145),
            255
        )
        MainStroke.Color = neonColor
        CenterStroke.Color = neonColor
        MusicBarStroke.Color = neonColor
        ToggleStroke.Color = neonColor
        TopGlow.BackgroundColor3 = neonColor

        if bgSound and bgSound.IsPlaying and bgSound.TimeLength > 0 and currentProgressBar then
            local percent = math.clamp(bgSound.TimePosition / bgSound.TimeLength, 0, 1)
            currentProgressBar.Size = UDim2.new(percent, 0, 1, 0)
        end

        local char = LocalPlayer.Character
        local rootPart = char and char:FindFirstChild("HumanoidRootPart")
        local rootJoint = rootPart and rootPart:FindFirstChild("RootJoint")

        if rootJoint and isHipSwayEnabled then
            local t = tick() * 6.5
            local bodySwayX = math.sin(t * 2) * 0.25
            local bodySwayY = math.cos(t) * 0.35
            local bodySwayZ = math.sin(t) * 0.75
            rootJoint.C0 = rootJoint.C0:Lerp(CFrame.new(0, bodySwayY, 0) * CFrame.Angles(math.rad(bodySwayX * 20), 0, bodySwayZ), 0.4)
        end
    end)
end)
