local isRunning = false
local OriginalFishingSpotCFrame = nil

local function simulateLagSpike(sec)
    local start = tick()
    while tick() - start < (sec or 0.8) do
        for i = 1, 3000000 do
            local _ = math.sin(i) * math.cos(i)
        end
    end
end

local function teleportAndRespawnAtIsland(targetPos)
    pcall(function()
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        
        task.spawn(function() simulateLagSpike(0.8) end)
        
        local isTeleporting = true
        local connection
        connection = LocalPlayer.CharacterAdded:Connect(function(newChar)
            if not isTeleporting then return end
            isTeleporting = false
            if connection then connection:Disconnect() end
            
            task.spawn(function()
                local newRoot = newChar:WaitForChild("HumanoidRootPart", 10)
                local newHum = newChar:WaitForChild("Humanoid", 10)
                if newRoot and newHum then
                    local targetCFrame = CFrame.new(targetPos + Vector3.new(0, 3, 0))
                    local lockStartTime = tick()
                    local lockConn
                    lockConn = RunService.RenderStepped:Connect(function()
                        if tick() - lockStartTime < 6.0 then
                            pcall(function()
                                newRoot.CFrame = targetCFrame
                                newRoot.Anchored = true
                                newHum.WalkSpeed = 0
                                for i = 1, 30000 do end
                            end)
                        else
                            if lockConn then lockConn:Disconnect() end
                            if isRunning then
                                OriginalFishingSpotCFrame = targetCFrame
                                newRoot.Anchored = true
                                newHum.WalkSpeed = 0
                            else
                                OriginalFishingSpotCFrame = nil
                                newRoot.Anchored = false
                                newHum.WalkSpeed = 16
                            end
                        end
                    end)
                end
            end)
        end)
        
        hum.Health = 0
    end)
end

