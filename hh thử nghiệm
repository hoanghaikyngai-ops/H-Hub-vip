-- VÒNG LẶP CÂU CÁ - ĐẢM BẢO CHUẨN LUỒNG 3 BƯỚC + BĂM TRÁI/PHẢI CÁ
-- =========================================================
task.spawn(function()
    local skillsList = {
        {key = Enum.KeyCode.Z, index = 1}, {key = Enum.KeyCode.X, index = 2},
        {key = Enum.KeyCode.C, index = 3}, {key = Enum.KeyCode.V, index = 4}
    }
    local lastSkillTick = 0
    
    while ScreenGui.Parent do
        task.wait(0.05)
        if isRunning and not isSellingFish then
            local char = LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            
            if root and hum then
                if not OriginalFishingSpotCFrame then OriginalFishingSpotCFrame = root.CFrame end

                -- [BÁN CÁ KHỎI KHO]
                if getFishToSellCount() >= maxFishCapacity and not isSellingFish then
                    isSellingFish = true
                    local vp = Camera.ViewportSize
                    VirtualInputManager:SendMouseButtonEvent(vp.X/2, vp.Y/2, 0, true, game, 1); task.wait(0.08)
                    VirtualInputManager:SendMouseButtonEvent(vp.X/2, vp.Y/2, 0, false, game, 1); task.wait(0.25)
                    root.Anchored = true; hum.WalkSpeed = 0; task.wait(0.05)

                    local dynamicMerchantPos = getMerchantPosition()
                    local safeTargetPos = dynamicMerchantPos - (CFrame.new(dynamicMerchantPos).LookVector * 3.5)
                    local dist = (root.Position - safeTargetPos).Magnitude
                    if merchantLockConnection then merchantLockConnection:Disconnect() end

                    merchantLockConnection = RunService.RenderStepped:Connect(function()
                        pcall(function()
                            local cc = LocalPlayer.Character
                            local cr = cc and cc:FindFirstChild("HumanoidRootPart")
                            local ch = cc and cc:FindFirstChildOfClass("Humanoid")
                            if cr and dynamicMerchantPos then
                                cr.Anchored = true; if ch then ch.WalkSpeed = 0 end
                                Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, dynamicMerchantPos)
                                cr.CFrame = CFrame.lookAt(cr.Position, Vector3.new(dynamicMerchantPos.X, cr.Position.Y, dynamicMerchantPos.Z))
                            end
                        end)
                    end)

                    local merchantTween = TweenService:Create(root, TweenInfo.new(dist / 55, Enum.EasingStyle.Linear), {CFrame = CFrame.new(safeTargetPos, dynamicMerchantPos)})
                    merchantTween:Play()
                    while merchantTween.PlaybackState == Enum.PlaybackState.Playing and isRunning do task.wait(0.05) end
                    root.CFrame = CFrame.new(safeTargetPos, dynamicMerchantPos); task.wait(0.3)

                    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game); task.wait(0.05)
                    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game); task.wait(0.5)

                    local sellStartTime = tick()
                    repeat
                        if not isRunning then break end
                        pcall(function() root.Anchored = true; hum.WalkSpeed = 0; root.CFrame = CFrame.new(safeTargetPos, dynamicMerchantPos) end)
                        clickBtn({"bán tất cả", "sell all", "bán", "sell"}); task.wait(0.25)
                        clickBtn({"xác nhận", "confirm", "đồng ý", "yes", "ok"}); task.wait(0.4)
                        if getFishToSellCount() <= 0 then task.wait(0.3); break end
                    until (tick() - sellStartTime > 10) or not isRunning

                    task.wait(0.4)
                    local byeStartTime = tick()
                    repeat
                        if not isRunning then break end
                        pcall(function() root.Anchored = true; hum.WalkSpeed = 0 end)
                        if clickBtn({"tạm biệt", "tam biet", "goodbye", "bye", "thoát", "close", "đóng", "x"}) then task.wait(0.5); break end
                        task.wait(0.25)
                    until (tick() - byeStartTime > 4.0) or not isRunning

                    if merchantLockConnection then merchantLockConnection:Disconnect(); merchantLockConnection = nil end

                    if OriginalFishingSpotCFrame then
                        root.Anchored = false; hum.WalkSpeed = 16
                        local dBack = (root.Position - OriginalFishingSpotCFrame.Position).Magnitude
                        local backTween = TweenService:Create(root, TweenInfo.new(dBack / 55, Enum.EasingStyle.Linear), {CFrame = OriginalFishingSpotCFrame})
                        backTween:Play()
                        while backTween.PlaybackState == Enum.PlaybackState.Playing and isRunning do task.wait(0.05) end
                        root.CFrame = OriginalFishingSpotCFrame
                    end
                    isSellingFish = false
                    continue
                end

                -- KHÓA VỊ TRÍ TẠI ĐIỂM CÂU
                if OriginalFishingSpotCFrame then root.CFrame = OriginalFishingSpotCFrame end
                root.Anchored = true; hum.WalkSpeed = 0

                -- CẦM CẦN CÂU NẾU CHƯA CẦM
                local activeTool = char and char:FindFirstChildOfClass("Tool")
                local isHoldingRod = activeTool and (string.lower(activeTool.Name):find("rod") or string.lower(activeTool.Name):find("cần"))
                if not isHoldingRod then
                    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.One, false, game); task.wait(0.02)
                    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.One, false, game); task.wait(0.1)
                end

                -- [BƯỚC 1: THẢ CẦU CÂU TỨC THÌ]
                local vp = Camera.ViewportSize
                local castX, castY = vp.X / 2, vp.Y / 2 - 80
                
                VirtualInputManager:SendMouseButtonEvent(castX, castY, 0, true, game, 1)
                if activeTool then pcall(function() activeTool:Activate() end) end
                task.wait(0.8)
                VirtualInputManager:SendMouseButtonEvent(castX, castY, 0, false, game, 1)

                -- [BƯỚC 2: CHỜ CÁ CẮN CÂU]
                task.wait(0.4)
                local caughtFishTarget = nil
                local waitBiteStart = tick()
                
                while isRunning and not isSellingFish and (tick() - waitBiteStart < 6.0) do
                    caughtFishTarget = findActiveFishTarget()
                    if caughtFishTarget then break end
                    task.wait(0.05)
                end

                -- [BƯỚC 3: BĂM CÁ ĐA PHẠM VI TRÁI/PHẢI/TRÊN/DƯỚI KHỦNG]
                if caughtFishTarget then
                    isFightingFish = true
                    pcall(function()
                        local fishFightStart = tick()
                        local offsetDistance = 25 -- Khoảng cách dải nhấp chuột quanh tâm cá (pixels)
                        local inset = GuiService:GetGuiInset()
                        local lastValidX, lastValidY = vp.X / 2, vp.Y / 2
                        
                        while isRunning and not isSellingFish and (tick() - fishFightStart < 12) do
                            local targetPart = findActiveFishTarget()
                            if not targetPart then 
                                task.wait(0.05)
                                targetPart = findActiveFishTarget()
                                if not targetPart then break end 
                            end
                            
                            local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                            if onScreen then 
                                lastValidX = screenPos.X + inset.X
                                lastValidY = screenPos.Y + inset.Y
                            end
                            
                            local cx, cy = lastValidX, lastValidY
                            VirtualInputManager:SendMouseMoveEvent(cx, cy, game)
                            
                            -- Danh sách tọa độ bao phủ: Trái, Phải, Trên, Dưới & Tâm
                            local attackOffsets = {
                                {x = cx - offsetDistance, y = cy}, -- Trái
                                {x = cx + offsetDistance, y = cy}, -- Phải
                                {x = cx, y = cy - offsetDistance}, -- Trên
                                {x = cx, y = cy + offsetDistance}, -- Dưới
                                {x = cx, y = cy}                    -- Tâm
                            }
                            
                            for _, pt in ipairs(attackOffsets) do
                                if not isRunning or isSellingFish then break end
                                VirtualInputManager:SendMouseButtonEvent(pt.x, pt.y, 0, true, game, 1)
                                task.wait(0.006)
                                VirtualInputManager:SendMouseButtonEvent(pt.x, pt.y, 0, false, game, 1)
                                task.wait(0.006)
                            end
                            
                            -- Kích hoạt kỹ năng phím ảo nếu có
                            if tick() - lastSkillTick > 1.2 then
                                lastSkillTick = tick()
                                pcall(function()
                                    for _, skill in ipairs(skillsList) do
                                        if not isRunning or isSellingFish then break end
                                        VirtualInputManager:SendKeyEvent(true, skill.key, false, game); task.wait(0.03)
                                        VirtualInputManager:SendKeyEvent(false, skill.key, false, game); task.wait(0.03)
                                        
                                        local btn = markerButtons[skill.index]
                                        if btn and MarkersGui.Enabled then
                                            local pos, sz = btn.AbsolutePosition, btn.AbsoluteSize
                                            VirtualInputManager:SendMouseButtonEvent(pos.X+sz.X/2+inset.X, pos.Y+sz.Y/2+inset.Y, 0, true, game, 1); task.wait(0.03)
                                            VirtualInputManager:SendMouseButtonEvent(pos.X+sz.X/2+inset.X, pos.Y+sz.Y/2+inset.Y, 0, false, game, 1); task.wait(0.03)
                                        end
                                    end
                                end)
                            end
                            task.wait(0.02)
                        end
                    end)
                    isFightingFish = false
                end
                
                task.wait(0.3)
            end
        end
    end
end)

