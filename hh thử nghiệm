local function resetStreak(s, initial)
    local H = getH()
    s.x = math.random()
    s.speed = math.random(280, 780)
    s.h = math.random(90, 290)
    s.y = initial and math.random(-s.h, H) or (-s.h - math.random(0, 350))
    s.f.Size = UDim2.fromOffset(s.w, s.h)
end

for i = 1, STREAK_COUNT do
    local w = math.random(1, 3)
    local f = new("Frame", {
        BackgroundColor3 = Color3.new(1, 1, 1),
        BackgroundTransparency = math.random() < 0.3 and 0.5 or math.random() * 0.2,
        BorderSizePixel = 0,
        AnchorPoint = Vector2.new(0.5, 1),
    }, streakLayer)
    gradient(f,
        ColorSequence.new(BLUE, ICE),
        NumberSequence.new({ KP(0, 1), KP(0.7, 0.7), KP(1, 0) }),
        90)
    local head = new("Frame", {
        BackgroundColor3 = ICE,
        BorderSizePixel = 0,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 1),
        Size = UDim2.fromOffset(w + 3, w + 3),
    }, f)
    round(head)
    local s = { f = f, w = w }
    resetStreak(s, true)
    streaks[i] = s
end

