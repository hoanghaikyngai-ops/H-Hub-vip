local HOLE_AT, REVEAL_AT, REVEAL_DUR = 0.4, 3.2, 1.6
local PROGRESS_END = CONFIG.Duration - 0.9

TweenService:Create(curtain, TweenInfo.new(0.9), { BackgroundTransparency = 1 }):Play()
task.delay(HOLE_AT, function()
    hole.Visible = true
