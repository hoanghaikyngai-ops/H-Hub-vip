local function makeOrb(color)
    local layers = {}
    for i = 1, 5 do
        local f = new("Frame", {
            AnchorPoint = V2(0.5, 0.5), BackgroundColor3 = color, BackgroundTransparency = 1,
            BorderSizePixel = 0, ZIndex = 4,
        }, fx)
        new("UICorner", {CornerRadius = UDim.new(1, 0)}, f)
        layers[i] = f
    end
    local core = new("Frame", {
        AnchorPoint = V2(0.5, 0.5), BackgroundColor3 = color:Lerp(WHITE, 0.7),
        BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 5,
    }, fx)
    new("UICorner", {CornerRadius = UDim.new(1, 0)}, core)

    local orb = {}
    function orb.update(x, y, size, intensity, ox, oy)
        ox, oy = ox or 0, oy or 0
        for i, f in ipairs(layers) do
            local s = size * (1 + (i - 1) * 0.55)
            f.Position = UDim2.new(x, ox, y, oy)
            f.Size = UDim2.fromOffset(s, s)
            f.BackgroundTransparency = 1 - math.clamp(intensity * 0.32 / (i ^ 0.5), 0, 0.9)
        end
        core.Position = UDim2.new(x, ox, y, oy)
        core.Size = UDim2.fromOffset(size * 0.7, size * 0.7)
        core.BackgroundTransparency = 1 - clamp01(intensity)
    end
    return orb
end

