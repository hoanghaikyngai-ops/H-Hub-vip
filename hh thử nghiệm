local function spawnSlash(t, o)
    local len = gui.AbsoluteSize.X * (o.lenMul or rng:NextNumber(0.3, 0.65))
    local f = new("Frame", {
        AnchorPoint = V2(0.5, 0.5),
        Position = UDim2.fromScale(
            rng:NextNumber(o.x1 or 0.5, o.x2 or 0.95),
            rng:NextNumber(o.y1 or 0.2, o.y2 or 0.8)
        ),
        Size = UDim2.fromOffset(0, o.th or 5), Rotation = o.rot or rng:NextNumber(-50, 50),
        BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = 6,
    }, o.parent or fx)
    new("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, o.c1 or RED),
            ColorSequenceKeypoint.new(0.5, o.c2 or WHITE),
            ColorSequenceKeypoint.new(1, o.c1 or RED),
        }),
    }, f)
    local life = o.life or rng:NextNumber(0.25, 0.45)
    table.insert(slashes, {
        f = f, born = t, life = life, len = len, th = o.th or 5,
        drawT = o.drawT or (life / 3), hold = o.hold or 0,
    })
end

