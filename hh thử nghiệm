local function makeImagePlane(size, cf, imageId, name)
    local p = Instance.new("Part")
    p.Anchored = true
    p.CanCollide = false
    p.CanQuery = false
    p.CanTouch = false
    p.CastShadow = false
    p.Size = size
    p.CFrame = cf
    p.Transparency = 1
    p.Parent = scene

    local function setupFace(face)
        local sg = Instance.new("SurfaceGui")
        sg.Face = face
        sg.AlwaysOnTop = false
        sg.Parent = p

        local img = Instance.new("ImageLabel")
        img.Size = UDim2.fromScale(1, 1)
        img.BackgroundTransparency = 1
        img.ScaleType = Enum.ScaleType.Fit
        img.Image = "rbxassetid://" .. tostring(imageId)
        img.Parent = sg
    end

    setupFace(Enum.NormalId.Front)
    setupFace(Enum.NormalId.Back)
    return p
end

