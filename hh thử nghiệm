local function makeRing(scale, thick, speed)
    local f = circle(scale, { BackgroundTransparency = 1 }, 3)
    local st = new("UIStroke", {
        Thickness = thick,
        Color = Color3.new(1, 1, 1),
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
