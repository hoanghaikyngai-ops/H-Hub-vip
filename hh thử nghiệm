------------------------------------------------------------
local function make3DOrb(color)
    local o = {}
    local core = mk(BALL, V3(1, 1, 1), color:Lerp(WHITE, 0.8), NEON)
    local shellScales = {1.5, 2.2, 3.2}
    local shellBase   = {0.35, 0.72, 0.9}
    local shells = {}
    for i = 1, 3 do shells[i] = mk(BALL, V3(1, 1, 1), color, NEON) end
    local N = 14
    local bits = {}
    for i = 1, N * 2 do bits[i] = mk(nil, V3(0.3, 0.3, 0.3), color:Lerp(WHITE, 0.55), NEON) end
    local R1 = CFrame.Angles(0.55, 0, 0.3)
    local R2 = CFrame.Angles(-0.45, 0, -0.95)

    local function hide()
        core.Transparency = 1
        for _, s in ipairs(shells) do s.Transparency = 1 end
        for _, b in ipairs(bits) do b.Transparency = 1 end
    end
    hide()

    function o.update(pos, size, inten, t, spin)
        if inten <= 0.01 or size <= 0.05 then hide() return end
        local d = size * 0.7
        core.Size = V3(d, d, d)
        core.Position = pos
        core.Transparency = 1 - inten
        for i, s in ipairs(shells) do
            local sd = size * shellScales[i]
            s.Size = V3(sd, sd, sd)
            s.Position = pos
            s.Transparency = 1 - (1 - shellBase[i]) * inten
        end
        local R = size * 1.3
        local bs = math.max(size * 0.09, 0.15)
        for i = 1, N do
            local a = i / N * math.pi * 2 + t * spin
            local b1 = bits[i]
            b1.Size = V3(bs, bs, bs)
            b1.Position = pos + R1:VectorToWorldSpace(V3(math.cos(a) * R, 0, math.sin(a) * R))
            b1.Transparency = 1 - inten
            local a2 = i / N * math.pi * 2 - t * spin * 0.8
            local b2 = bits[N + i]
            b2.Size = V3(bs, bs, bs)
            b2.Position = pos + R2:VectorToWorldSpace(V3(math.cos(a2) * R * 1.15, 0, math.sin(a2) * R * 1.15))
            b2.Transparency = 1 - inten
        end
    end
    return o
end

