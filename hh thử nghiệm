local camKeys = {
    {0.00, V3(-50, 10, 28), V3(-40, 5, 0), false},
    {0.40, V3(-44, 8, 18), V3(-36, 5, 0), false},
    {0.50, V3(-42, 7, 14), V3(-32, 5, 0), false},
    {0.545, V3(-43, 7, 15), V3(-30, 5, 0), false},
    {0.62, V3(26, 10, 30), V3(28, 6, 0), true},
    {0.70, V3(22, 9, 24), V3(24, 6, 0), false},
    {0.74, V3(14, 8, 20), V3(14, 6, 0), false},
}
local function camAt(u)
    local n = #camKeys
    if u <= camKeys[1][1] then return camKeys[1][2], camKeys[1][3] end
    for i = 1, n - 1 do
        local a, b = camKeys[i], camKeys[i + 1]
        if u <= b[1] then
            local k = clamp01((u - a[1]) / (b[1] - a[1]))
            if b[4] then k = ease(k) end
            return a[2]:Lerp(b[2], k), a[3]:Lerp(b[3], k)
        end
    end
    return camKeys[n][2], camKeys[n][3]
end

