local function corner(obj, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 10)
    c.Parent = obj
end
local function stroke(obj, color, thick, transp)
    local s = Instance.new("UIStroke")
    s.Color = color
    s.Thickness = thick or 1
    s.Transparency = transp or 0.4
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = obj
    return s
end
local function gradient(obj, c1, c2, rot)
    local g = Instance.new("UIGradient")
    g.Color = ColorSequence.new({ColorSequenceKeypoint.new(0, c1), ColorSequenceKeypoint.new(1, c2)})
    g.Rotation = rot or 90
    g.Parent = obj
    return g
end
local function addHover(btn, baseColor, hoverColor)
    btn.AutoButtonColor = false
    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.18), {BackgroundColor3 = hoverColor}):Play()
    end)
    btn.MouseLeave:Connect(function()
        -- không ép màu nếu đang ở trạng thái BẬT (logic sẽ tự set), chỉ fade nhẹ
        TweenService:Create(btn, TweenInfo.new(0.25), {BackgroundColor3 = btn:GetAttribute("BaseColor") or baseColor}):Play()
    end)
    btn:SetAttribute("BaseColor", baseColor)
    -- giữ BaseColor đồng bộ khi logic đổi màu
    btn:GetPropertyChangedSignal("BackgroundColor3"):Connect(function()
        -- tránh loop: chỉ lưu khi khác do logic set
    end)
end

