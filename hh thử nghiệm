local function setReveal(p)
    local len = utf8.len(displayName) or #displayName
    local n = math.floor(len * p)
    local cut = (n >= len) and #displayName or (utf8.offset(displayName, n + 1) - 1)
    local a = displayName:sub(1, cut)
    local b = displayName:sub(cut + 1)
    nameLabel.Text = esc(a) .. '<font transparency="1">' .. esc(b) .. "</font>"
end
setReveal(0)

local lastRevealCount = -1
local conn = RunService.Heartbeat:Connect(function(dt)
    local now = os.clock() - t0
    local H = getH()

    -- Vệt xanh rơi
    for _, s in ipairs(streaks) do
        s.y = s.y + s.speed * dt
        if s.y - s.h > H then resetStreak(s, false) end
        s.f.Position = UDim2.new(s.x, 0, 0, s.y)
    end

    -- Cột hex
    for _, c in ipairs(cols) do
        c.y = c.y + c.speed * dt
        if c.y > H then c.y = -34 * 13 end
        c.f.Position = UDim2.new(c.x, 0, 0, c.y)
    end

    -- Hạt xoáy vào hố đen
    local show = now > 1.4
    for _, p in ipairs(particles) do
        p.f.Visible = show
        if show then
            local rn = p.r / R
            p.r = p.r - dt * R * (0.10 + 0.30 / rn)
            p.a = p.a + dt * (0.5 + 2.4 / rn)
            if p.r <= R then respawnParticle(p, false) end
            p.f.Position = UDim2.new(0.5, math.cos(p.a) * p.r, CY, math.sin(p.a) * p.r)
            p.f.BackgroundTransparency = math.clamp((p.r / R - 1) / 1.8, 0, 1) * 0.85
        end
    end

    -- Vòng quay
    for _, r in ipairs(rings) do
        r.g.Rotation = (r.g.Rotation + r.speed * dt) % 360
    end

    -- Vầng sáng đập nhịp
    for i, g in ipairs(glows) do
        local sc = g.base + 0.05 * math.sin(now * 2.2 + i * 0.7)
        g.f.Size = UDim2.fromScale(sc, sc)
    end
    diskWide.Size = UDim2.fromScale(3.1 + 0.15 * math.sin(now * 1.7), 0.09 + 0.02 * math.sin(now * 3))
    diskThin.Size = UDim2.fromScale(2.5 + 0.2 * math.sin(now * 2.1), 0.012)

    -- Thanh quét
    scan.Position = UDim2.new(0, 0, 0, ((now * 0.3) % 1) * H)

    -- Hiện chữ
    local fa = math.clamp((now - (REVEAL_AT - 0.6)) / 0.8, 0, 1)
    tag.TextTransparency = 1 - fa * 0.85
    idLabel.TextTransparency = 1 - fa * 0.7

    local p = math.clamp((now - REVEAL_AT) / REVEAL_DUR, 0, 1)
    local count = math.floor(p * 1000)
    if count ~= lastRevealCount then
        lastRevealCount = count
        setReveal(p)
    end

    -- Glitch định kỳ sau khi hiện xong
    local doneAt = REVEAL_AT + REVEAL_DUR
    if now > doneAt and ((now - doneAt) % 2.6) < 0.14 then
        glitch.Visible = true
        glitch.Position = NAME_POS + UDim2.fromOffset(math.random(-5, 5), math.random(-2, 2))
    else
        glitch.Visible = false
    end

    -- Tiến trình
    local prog = math.clamp(now / PROGRESS_END, 0, 1)
    fill.Size = UDim2.fromScale(prog, 1)
    percentLabel.Text = string.format("%d%%", math.floor(prog * 100))
    local st = STATUS[1][2]
    for _, s in ipairs(STATUS) do
        if prog >= s[1] then st = s[2] end
    end
    statusLabel.Text = st .. string.rep(".", math.floor(now * 3) % 4)
end)

