local ProtectedItems = {"rod", "cần", "bait", "mồi", "potion", "license", "cá hiếm", "legendary", "mythical"}
local function getFishToSellCount()
    local count = 0
    local function check(cont)
        if cont then
            for _, i in ipairs(cont:GetChildren()) do
                if i:IsA("Tool") then
                    local n = string.lower(i.Name)
                    local isProtected = false
                    for _, kw in ipairs(ProtectedItems) do if n:find(kw) then isProtected = true; break end end
                    if not isProtected then count = count + 1 end
                end
            end
        end
    end
    check(LocalPlayer.Backpack); check(LocalPlayer.Character)
    return count
end

