-- NGÔI ĐỀN CỦA SUKUNA (Malevolent Shrine) - nhiều tầng mái cong, đầu lâu, sừng, xương
------------------------------------------------------------
local function buildShrine()
    local rig = newRig()
    local DARK  = Color3.fromRGB(26, 17, 22)
    local WOOD  = Color3.fromRGB(46, 28, 30)
    local LAC   = Color3.fromRGB(150, 18, 28)
    local BONE  = Color3.fromRGB(236, 226, 206)
    local STONE = Color3.fromRGB(46, 40, 52)
    local GLOW  = Color3.fromRGB(255, 50, 50)

    local function box(sx, sy, sz, cf, col, mat) rig.add(mk(nil, V3(sx, sy, sz), col, mat), cf) end
    local function ball(d, cf, col, mat) rig.add(mk(BALL, V3(d, d, d), col, mat), cf) end
    local function cyl(len, diam, cf, col, mat) rig.add(mk(CYL, V3(len, diam, diam), col, mat), cf) end

    -- Nền đá 3 bậc
    box(26, 1, 20, CFrame.new(0, 0.5, 0), STONE)
    box(23, 1, 17, CFrame.new(0, 1.5, 0), STONE)
    box(20, 1, 14, CFrame.new(0, 2.5, 0), STONE)
    box(5, 0.12, 10, CFrame.new(0, 3.05, -5), LAC)                     -- thảm đỏ

    -- Gian chính + cửa phát sáng
    box(18, 6, 10, CFrame.new(0, 6, 0), WOOD)
    box(5, 5, 0.3, CFrame.new(0, 5.6, -5.15), Color3.fromRGB(120, 10, 20), NEON)
    box(5.6, 0.25, 0.3, CFrame.new(0, 8.2, -5.2), DARK)
    box(0.25, 5.2, 0.3, CFrame.new(-2.8, 5.6, -5.2), DARK)
    box(0.25, 5.2, 0.3, CFrame.new(2.8, 5.6, -5.2), DARK)

    -- Cột đỏ phía trước
    for _, x in ipairs({-8, -4, 0, 4, 8}) do
        cyl(6.4, 1.1, CFrame.new(x, 6.2, -5.8) * CFrame.Angles(0, 0, math.pi / 2), LAC)
        box(1.7, 0.4, 1.7, CFrame.new(x, 3.2, -5.8), DARK)
        box(1.7, 0.5, 1.7, CFrame.new(x, 9.2, -5.8), DARK)
    end
    box(20, 0.8, 1.2, CFrame.new(0, 9.7, -5.8), DARK)
    for _, x in ipairs({-6, -2, 2, 6}) do                              -- cờ đỏ treo
        box(1.6, 3.4, 0.12, CFrame.new(x, 7.8, -6.5), LAC)
    end

    -- Mái 1 hình chữ A, mép cong
    local function roof(w, halfDepth, ya, a)
        local slope = halfDepth / math.cos(a)
        local drop = slope * math.sin(a)
        local cy = ya - drop / 2
        local cz = halfDepth / 2
        box(w, 0.9, slope, CFrame.new(0, cy, -cz) * CFrame.Angles(-a, 0, 0), DARK)
        box(w, 0.9, slope, CFrame.new(0, cy, cz) * CFrame.Angles(a, 0, 0), DARK)
        box(w + 1, 0.9, 1.4, CFrame.new(0, ya + 0.2, 0), LAC)            -- nóc
        local ey = ya - drop
        box(w + 1.5, 0.7, 3, CFrame.new(0, ey + 0.35, -(halfDepth + 1.2)) * CFrame.Angles(0.45, 0, 0), DARK)  -- mép cong lên
        box(w + 1.5, 0.7, 3, CFrame.new(0, ey + 0.35, (halfDepth + 1.2)) * CFrame.Angles(-0.45, 0, 0), DARK)
        box(w + 1.5, 0.22, 0.25, CFrame.new(0, ey + 0.85, -(halfDepth + 2.3)), GLOW, NEON)                  -- viền đỏ phát sáng
        box(w + 1.5, 0.22, 0.25, CFrame.new(0, ey + 0.85, (halfDepth + 2.3)), GLOW, NEON)
    end
    roof(24, 10.5, 14.5, 0.40)

