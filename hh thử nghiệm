    if not root then return nil end

    local closestFish = nil
    local minDistance = 45 -- Bán kính quét tối đa xung quanh nhân vật (studs)

    local overlapParams = OverlapParams.new()
    overlapParams.FilterType = RaycastFilterType.Exclude
    overlapParams.FilterDescendantsInstances = {char}

    local nearbyParts = Workspace:GetPartBoundsInRadius(root.Position, minDistance, overlapParams)

    for _, part in ipairs(nearbyParts) do
        local parentModel = part:FindFirstAncestorOfClass("Model") or part.Parent
        if parentModel and not Players:GetPlayerFromCharacter(parentModel) then
            local name = string.lower(part.Name .. " " .. parentModel.Name)
            
            -- Lọc bỏ cần câu, mồi câu, merchant
            local isIgnored = name:find("rod") or name:find("cần") or name:find("bait") or name:find("mồi") or name:find("merchant")
            
            if not isIgnored then
                if name:find("fish") or name:find("catch") or name:find("shark") or name:find("whale") or name:find("mob") or name:find("boss") then
                    local dist = (part.Position - root.Position).Magnitude
                    if dist < minDistance then
                        minDistance = dist
                        closestFish = part
                    end
                end
            end
        end
    end

    return closestFish
end

