        BorderSizePixel = 0,
        ZIndex = z,
    }, hole)
    round(d)
    gradient(d,
        ColorSequence.new({ CKP(0, BLUE), CKP(0.5, ICE), CKP(1, BLUE) }),
        NumberSequence.new({ KP(0, 1), KP(0.35, 0.45), KP(0.5, 0.05), KP(0.65, 0.45), KP(1, 1) }),
        0)
    return d
end
