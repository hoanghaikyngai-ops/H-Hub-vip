local function buildSukuna()
    local rig = newRig()
    local SKIN  = Color3.fromRGB(255, 214, 190)
    local CREAM = Color3.fromRGB(236, 229, 216)
    local DARK  = Color3.fromRGB(24, 20, 30)
    local PINK  = Color3.fromRGB(255, 140, 170)
    local SASH  = Color3.fromRGB(150, 20, 30)

    rig.add(mk(nil, V3(3.8, 4.3, 2.2), DARK), CFrame.new(0, 2.15, 0))           -- hakama
    rig.add(mk(nil, V3(3.5, 3.8, 1.9), CREAM), CFrame.new(0, 6.0, 0))           -- áo
    rig.add(mk(nil, V3(3.7, 0.8, 2.1), SASH), CFrame.new(0, 4.3, 0))            -- đai
    rig.add(mk(BALL, V3(2.6, 2.6, 2.6), SKIN), CFrame.new(0, 9.6, 0))           -- đầu
    rig.add(mk(nil, V3(2.8, 0.9, 2.8), PINK), CFrame.new(0, 10.7, 0))           -- tóc hồng
    for i = 1, 8 do
        local a = i / 8 * math.pi * 2
        local pos = V3(math.cos(a) * 0.9, 11.0, math.sin(a) * 0.9)
        local dir = V3(math.cos(a) * 0.9, 1.0, math.sin(a) * 0.9)
        rig.add(mk(nil, V3(0.55, 0.55, 1.6), PINK), CFrame.lookAt(pos, pos + dir))
    end
    -- vằn mặt
    for _, sx in ipairs({-0.6, 0.6}) do
        rig.add(mk(nil, V3(0.12, 0.55, 0.12), BLACK), CFrame.new(sx, 9.25, -1.15))
        rig.add(mk(BALL, V3(0.32, 0.32, 0.32), RED, NEON), CFrame.new(sx * 0.85, 9.75, -1.2))
    end
    rig.add(mk(nil, V3(0.9, 0.12, 0.12), BLACK), CFrame.new(0, 10.1, -1.22))
    rig.add(mk(nil, V3(0.9, 0.1, 0.12), BLACK), CFrame.new(0, 8.85, -1.15))

    -- 4 tay: cặp trên (up) giơ lên, cặp dưới (low) buông
    for _, side in ipairs({-1, 1}) do
        local S1 = V3(side * 2.35, 7.5, 0)
        rig.add(mk(nil, V3(1.2, 2.2, 1.2), CREAM), nil, {S = S1, side = side, up = true, off = 1.1})
        rig.add(mk(nil, V3(0.95, 2.2, 0.95), SKIN), nil, {S = S1, side = side, up = true, off = 3.1})
        for _, o in ipairs({2.5, 3.1, 3.7}) do
            rig.add(mk(nil, V3(1.02, 0.12, 1.02), BLACK), nil, {S = S1, side = side, up = true, off = o})
        end
        local S2 = V3(side * 2.0, 5.4, 0)
        rig.add(mk(nil, V3(1.0, 1.8, 1.0), CREAM), nil, {S = S2, side = side, up = false, off = 0.9})
        rig.add(mk(nil, V3(0.85, 2.0, 0.85), SKIN), nil, {S = S2, side = side, up = false, off = 2.6})
    end
    return rig
end

