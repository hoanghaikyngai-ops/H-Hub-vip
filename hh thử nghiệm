local function make3DOrb(color)
    local o = {}
    local core = Instance.new("Part")
    core.Shape = Enum.PartType.Ball
    core.Anchored = true
    core.CanCollide = false
    core.Material = Enum.Material.Neon
    core.Color = color:Lerp(WHITE, 0.8)
    core.Parent = scene

    local shells = {}
    for i = 1, 2 do
        local s = Instance.new("Part")
        s.Shape = Enum.PartType.Ball
        s.Anchored = true
        s.CanCollide = false
        s.Material = Enum.Material.Neon
        s.Color = color
        s.Parent = scene
        shells[i] = s
    end

    function o.update(pos, size, inten)
        if inten <= 0.01 or size <= 0.05 then
            core.Transparency = 1
            for _, s in ipairs(shells) do s.Transparency = 1 end
            return
        end
        core.Size = V3(size, size, size)
        core.Position = pos
        core.Transparency = 1 - inten
        for i, s in ipairs(shells) do
            local sd = size * (1.4 + i * 0.5)
            s.Size = V3(sd, sd, sd)
            s.Position = pos
            s.Transparency = 1 - (0.4 / i) * inten
        end
    end
    return o
end

