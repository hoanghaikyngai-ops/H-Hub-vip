task.delay(D + 2, finish)

local function step(dt)
    local t = os.clock() - startTime
    local u = clamp01(t / D)

    local T_EXPLODE = 0.74
    local T_TEARSLASH, T_TEAR, T_OPEN2, T_OFF, T_END = 0.775, 0.815, 0.86, 0.90, 0.97

    local finalFade = sm(T_END, 1, u)
    local fadeIn = 1 - sm(0, 0.05, u)
    root.GroupTransparency = math.max(fadeIn, finalFade)
    vp.ImageTransparency = math.max(fadeIn, finalFade)
    sky.BackgroundTransparency = finalFade
    backdrop.BackgroundTransparency = sm(0.98, 1, u)
    sound.Volume = MUSIC_VOL * (1 - finalFade)

    local bar = sm(0, 0.08, u)
    barTop.Position = UDim2.fromScale(0, -0.1 + 0.1 * bar)
    barBot.Position = UDim2.fromScale(0, 1 - 0.1 * bar)

    if u >= 0.50 and not flagCollide then flagCollide = true; burst = 24 end
    if u >= 0.545 and not flagFire then flagFire = true; burst = 18 end
    if u >= 0.60 and not flagSukuna then flagSukuna = true; burst = 12 end
    burst = math.max(burst - dt * 40, 0)

    local amp = 0
    if u >= 0.30 and u < 0.50 then amp = 3 * sm(0.30, 0.50, u)
    elseif u >= 0.50 and u < 0.545 then amp = 10
    elseif u >= 0.62 and u < 0.69 then amp = 8
    elseif u >= 0.69 and u < T_EXPLODE then amp = 8 + 24 * sm(0.69, T_EXPLODE, u)
    elseif u >= T_EXPLODE and u < 0.77 then amp = 30 * (1 - sm(T_EXPLODE, 0.77, u)) end
    amp += burst
    local shx, shy = 0, 0
    if amp > 0 then
        shx = (rng:NextNumber() - 0.5) * 2 * amp
        shy = (rng:NextNumber() - 0.5) * 2 * amp
    end
    root.Position = UDim2.fromOffset(shx, shy)
    vp.Position = UDim2.fromOffset(shx, shy)

    local cpos, ctarget = camAt(u)
    cpos += V3(math.sin(t * 0.5) * 1.0, math.sin(t * 0.7) * 0.4, 0)
    if amp > 0 then cpos += V3(rng:NextNumber() - 0.5, rng:NextNumber() - 0.5, 0) * amp * 0.03 end
    cam.CFrame = CFrame.lookAt(cpos, ctarget)

    if u < T_EXPLODE + 0.01 then
        local appear = sm(0.03, 0.12, u)
        gojoPlane.Transparency = 1 - appear
        gojoPlane.CFrame = CFrame.lookAt(G_POS, G_POS + V3(1, 0, 0.25))

        gojoAura.Position = G_POS + V3(0, 3, 0)
        local gaSize = 12 + 2 * math.sin(t * 6)
        gojoAura.Size = V3(gaSize, gaSize, gaSize)
        gojoAura.Transparency = 1 - 0.2 * appear

        local orbAppear = sm(0.16, 0.28, u)
        local gone = 1 - sm(0.495, 0.505, u)
        local osize = 0.5 + 3.5 * orbAppear + 1.0 * sm(0.28, 0.40, u)
        local oint = orbAppear * gone
        local m = clamp01((u - 0.40) / 0.10)
        local m2 = m * m
        blueOrb.update(HOLD_BLUE:Lerp(CP, m2), osize, oint)
        redOrb.update(HOLD_RED:Lerp(CP, m2), osize, oint)

        local pu = clamp01((u - 0.50) / 0.04)
        local pf = clamp01((u - 0.545) / 0.175)
        local ppos = CP:Lerp(HIT, pf ^ 1.6)
        local psize = 3 + 8 * ease(pu) + 50 * (sm(0.72, 0.742, u) ^ 2)
        local pint = sm(0.50, 0.515, u) * (1 - sm(0.742, 0.748, u))
        purpleOrb.update(ppos, psize, pint)

        local sApp = sm(0.56, 0.62, u)
        sukunaPlane.Transparency = 1 - sApp
        sukunaPlane.CFrame = CFrame.lookAt(S_POS, S_POS + V3(-1, 0, 0.3))

        sukunaAura.Position = S_POS + V3(0, 3, 0)
        sukunaAura.Size = V3(14, 14, 14)
        sukunaAura.Transparency = 1 - 0.2 * sApp

        local rise = sm(0.62, 0.69, u)
        if u >= 0.58 then
            local shPos = SH_POS + V3(0, -30 * (1 - rise), 0)
            shrine.pose(CFrame.lookAt(shPos, shPos + V3(-1, 0, 0.6)))
            shrine.setTransparency(1 - rise)
        end
    end

    local nameText, nameCol, nameVis
    if u < 0.56 then
        nameText, nameCol = "GOJO", BLUE
        nameVis = sm(0.10, 0.16, u) * (1 - sm(0.46, 0.52, u))
    else
        nameText, nameCol = "SUKUNA", RED
        nameVis = sm(0.62, 0.68, u) * (1 - sm(0.71, 0.74, u))
    end
    if nameText ~= lastName then
        lastName = nameText
        nameLbl.Text = nameText
        nameLbl.TextColor3 = nameCol
    end
    nameLbl.TextTransparency = 1 - nameVis

    local aB = pulse(u, 0.06, 0.03, 0.5)
    local aP = pulse(u, 0.50, 0.03, 0.7)
    local aR = pulse(u, 0.60, 0.03, 0.5)
    local aMax = math.max(aB, aP, aR)
    if aMax == aP then tint.BackgroundColor3 = PURPLE
    elseif aMax == aR then tint.BackgroundColor3 = RED
    else tint.BackgroundColor3 = BLUE end
    tint.BackgroundTransparency = 1 - aMax

    local fl
    if u < T_EXPLODE - 0.002 then fl = 1
    elseif u < T_EXPLODE + 0.002 then fl = 1 - (u - (T_EXPLODE - 0.002)) / 0.004
    else fl = (u - (T_EXPLODE + 0.002)) / 0.028 end
    flash.BackgroundTransparency = math.clamp(fl, 0, 1)

    local whiteOn = u >= T_EXPLODE and u < T_OFF + 0.005
    halfA.Visible = whiteOn
    halfB.Visible = whiteOn
    reveal.Visible = u >= T_EXPLODE and u < T_END + 0.03
    local wTrans = 1 - sm(T_EXPLODE, T_EXPLODE + 0.006, u)
    halfA.BackgroundTransparency = wTrans
    halfB.BackgroundTransparency = wTrans

    if u >= 1 then finish() end
end

conn = RunService.RenderStepped:Connect(function(dt)
    pcall(step, dt)
end)

