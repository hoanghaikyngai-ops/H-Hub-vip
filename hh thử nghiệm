-- LocalScript đặt trong StarterPlayerScripts hoặc Chạy qua Executor (Delta, Fluxus,...)
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local CoreGui = game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer

-- Tạo UI
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "CoordPickerUI"
ScreenGui.Parent = (gethui and gethui()) or CoreGui or LocalPlayer:WaitForChild("PlayerGui")

local Frame = Instance.new("Frame")
Frame.Size = UDim2.new(0, 260, 0, 110)
Frame.Position = UDim2.new(0.5, -130, 0.2, 0)
Frame.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
Frame.BorderSizePixel = 0
Frame.Active = true
Frame.Draggable = true
Frame.Parent = ScreenGui

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 10)
UICorner.Parent = Frame

local Title = Instance.new("TextLabel")
Title.Size = UDim2.new(1, 0, 0, 30)
Title.Text = "Tọa độ Bán Cá"
Title.TextColor3 = Color3.fromRGB(0, 255, 170)
Title.TextSize = 16
Title.Font = Enum.Font.SourceSansBold
Title.BackgroundTransparency = 1
Title.Parent = Frame

local PosLabel = Instance.new("TextLabel")
PosLabel.Size = UDim2.new(1, -20, 0, 30)
PosLabel.Position = UDim2.new(0, 10, 0, 30)
PosLabel.Text = "X: 0, Y: 0, Z: 0"
PosLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
PosLabel.TextSize = 14
PosLabel.Font = Enum.Font.Code
PosLabel.BackgroundTransparency = 1
PosLabel.Parent = Frame

local CopyBtn = Instance.new("TextButton")
CopyBtn.Size = UDim2.new(1, -20, 0, 32)
CopyBtn.Position = UDim2.new(0, 10, 0, 68)
CopyBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
CopyBtn.Text = "Copy Vector3"
CopyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
CopyBtn.TextSize = 14
CopyBtn.Font = Enum.Font.SourceSansBold
CopyBtn.Parent = Frame

local BtnCorner = Instance.new("UICorner")
BtnCorner.CornerRadius = UDim.new(0, 6)
BtnCorner.Parent = CopyBtn

-- Cập nhật tọa độ liên tục
local currentPosStr = ""
local currentVector = Vector3.new(0,0,0)

task.spawn(function()
    while task.wait(0.1) do
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local pos = LocalPlayer.Character.HumanoidRootPart.Position
            currentVector = pos
            currentPosStr = string.format("%.1f, %.1f, %.1f", pos.X, pos.Y, pos.Z)
            PosLabel.Text = "X: " .. math.floor(pos.X) .. " | Y: " .. math.floor(pos.Y) .. " | Z: " .. math.floor(pos.Z)
        end
    end
end)

-- Nút Copy
CopyBtn.MouseButton1Click:Connect(function()
    local codeToCopy = "Vector3.new(" .. currentPosStr .. ")"
    if setclipboard then
        setclipboard(codeToCopy)
        CopyBtn.Text = "Đã Copy vào Clipboard!"
        CopyBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
        task.wait(1.5)
        CopyBtn.Text = "Copy Vector3"
        CopyBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
    else
        print("Tọa độ của bạn:", codeToCopy)
        CopyBtn.Text = "Đã in ra F12 / Console"
    end
end)
