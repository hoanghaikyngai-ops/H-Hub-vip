local BALL, CYL = Enum.PartType.Ball, Enum.PartType.Cylinder
local NEON, SMOOTH = Enum.Material.Neon, Enum.Material.SmoothPlastic

local function mk(shape, size, color, mat)
    local p = Instance.new("Part")
    p.Anchored = true
    p.CanCollide = false
    p.CanQuery = false
    p.CanTouch = false
    p.CastShadow = false
    p.TopSurface = Enum.SurfaceType.Smooth
    p.BottomSurface = Enum.SurfaceType.Smooth
    if shape then p.Shape = shape end
    p.Size = size
    p.Color = color
    p.Material = mat or SMOOTH
    p.Parent = scene
    return p
end

-- "Rig": tập hợp part có toạ độ cục bộ, đặt theo rootCF mỗi khung hình. Part tay xoay quanh vai.
local function newRig()
    local rig = {parts = {}}
    function rig.add(p, cf, arm)
        table.insert(rig.parts, {p = p, cf = cf, arm = arm})
    end
    function rig.pose(rootCF, a)
        for _, e in ipairs(rig.parts) do
            local arm = e.arm
            if arm then
                local th = arm.up and a.upX or a.lowX
                local sp = arm.up and a.upSp or a.lowSp
                e.p.CFrame = rootCF * CFrame.new(arm.S) * CFrame.Angles(th, 0, arm.side * sp) * CFrame.new(0, -arm.off, 0)
            else
                e.p.CFrame = rootCF * e.cf
            end
        end
    end
    function rig.setTransparency(tr)
        for _, e in ipairs(rig.parts) do e.p.Transparency = tr end
    end
    return rig
end

