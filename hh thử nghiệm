conn = RunService.RenderStepped:Connect(function(dt)
    local t = os.clock() - startTime
    local u = clamp01(t / D)

    local T_ORBIT0, T_MERGE, T_EXPLODE = 0.10, 0.60, 0.74
    local T_TEARSLASH, T_TEAR, T_OPEN2, T_OFF, T_END = 0.775, 0.815, 0.86, 0.90, 0.97

    root.GroupTransparency = math.max(1 - sm(0, 0.05, u), sm(T_END, 1, u))
    backdrop.BackgroundTransparency = sm(0.98, 1, u)
    sound.Volume = MUSIC_VOL * (1 - sm(T_END, 1, u))

    local bar = sm(0, 0.08, u)
    barTop.Position = UDim2.fromScale(0, -0.1 + 0.1 * bar)
    barBot.Position = UDim2.fromScale(0, 1 - 0.1 * bar)

    burst = math.max(burst - dt * 40, 0)
    local amp = 0
    if u >= 0.40 and u < T_MERGE then amp = 4 * sm(0.40, T_MERGE, u)
    elseif u >= T_MERGE and u < T_EXPLODE then amp = 4 + 26 * sm(T_MERGE, T_EXPLODE, u)
    elseif u >= T_EXPLODE and u < 0.77 then amp = 30 * (1 - sm(T_EXPLODE, 0.77, u)) end
    amp += burst
    if amp > 0 then
        root.Position = UDim2.fromOffset((rng:NextNumber() - 0.5) * 2 * amp, (rng:NextNumber() - 0.5) * 2 * amp)
    else
        root.Position = UDim2.fromOffset(0, 0)
    end

    local gone = 1 - sm(T_MERGE, T_MERGE + 0.03, u)
    local spin = sm(T_ORBIT0, T_MERGE, u)
    theta += dt * (1.5 + 8 * spin)
    local orbitR = 200 * (1 - 0.92 * spin)
    local ox, oy = math.cos(theta) * orbitR, math.sin(theta) * orbitR * 0.7
    local osize = (40 + 90 * sm(0.08, 0.40, u) + 30 * sm(0.40, T_MERGE, u)) * gone * (1 + 0.06 * math.sin(t * 8))
    local oint = sm(0.05, 0.30, u) * gone
    blueOrb.update(GOJO_X, GOJO_Y, osize, oint, ox, oy)
    redOrb.update(GOJO_X, GOJO_Y, osize, oint, -ox, -oy)

    local px = clamp01((u - T_MERGE) / (T_EXPLODE - T_MERGE))
    local pSize = (40 + 1300 * px * px) * (1 + 0.06 * math.sin(t * (10 + 20 * px)))
    local pInten = sm(T_MERGE, T_MERGE + 0.05, u) * (1 - sm(T_EXPLODE - 0.002, T_EXPLODE + 0.002, u))
    purpleOrb.update(GOJO_X + (0.5 - GOJO_X) * ease(px), GOJO_Y, pSize, pInten)

    local tClash = T_MERGE * D
    for _, r in ipairs(rings) do
        local age = t - tClash - r.delay
        if age > 0 and age < 1.4 then
            local k = age / 1.4
            r.f.Visible = true
            local s = 2000 * ease(k)
            r.f.Size = UDim2.fromOffset(s, s)
            r.st.Thickness = 10 * (1 - k) + 1
            r.st.Transparency = k ^ 1.5
        else
            r.f.Visible = false
        end
    end

    local grow = sm(0.10, 0.22, u)
    local houseBase = math.clamp(gui.AbsoluteSize.Y / 900, 0.45, 1)
    houseScale.Scale = math.max(houseBase * grow, 0.01)
    local jit = 1 + 5 * sm(0.4, T_EXPLODE, u)
    house.Position = UDim2.new(
        HOUSE_X, (rng:NextNumber() - 0.5) * jit,
        HOUSE_Y, (1 - grow) * 40 + (rng:NextNumber() - 0.5) * jit
    )
    local aSize = (140 + 160 * sm(0.2, T_EXPLODE, u)) * houseBase * grow * (1 + 0.07 * math.sin(t * 9))
    houseAura.update(HOUSE_X, HOUSE_Y, aSize, (0.4 + 0.6 * sm(0.2, T_EXPLODE, u)) * grow)

    local rate = 0
    if u >= 0.20 and u < 0.40 then rate = 3
    elseif u >= 0.40 and u < T_MERGE then rate = 7
    elseif u >= T_MERGE and u < T_EXPLODE then rate = 12 end
    if rate > 0 and t - lastSlash > 1 / rate then
        lastSlash = t
        spawnRadial(t, rng:NextNumber(0, 360))
    end

    local nameT = 1 - sm(0.12, 0.20, u) * gone
    gojoName.TextTransparency = nameT
    sukunaName.TextTransparency = nameT

    local imgIn = sm(0.10, 0.30, u) * gone
    if gojoImg then
        gojoImg.Position = UDim2.fromScale(-0.4 + 0.4 * sm(0.10, 0.30, u), 0.5)
        gojoImg.ImageTransparency = 1 - 0.9 * imgIn
    end
    if sukunaImg then
        sukunaImg.Position = UDim2.fromScale(1.4 - 0.4 * sm(0.10, 0.30, u), 0.5)
        sukunaImg.ImageTransparency = 1 - 0.9 * imgIn
    end

    local fl
    if u < T_EXPLODE - 0.002 then fl = 1
    elseif u < T_EXPLODE + 0.002 then fl = 1 - (u - (T_EXPLODE - 0.002)) / 0.004
    elseif u < T_EXPLODE + 0.03 then fl = (u - (T_EXPLODE + 0.002)) / 0.028
    else fl = 1 end
    flash.BackgroundTransparency = math.clamp(fl, 0, 1)

    local whiteOn = u >= T_EXPLODE and u < T_OFF + 0.005
    halfA.Visible = whiteOn
    halfB.Visible = whiteOn
    reveal.Visible = u >= T_EXPLODE and u < T_END + 0.03
    local wTrans = 1 - sm(T_EXPLODE, T_EXPLODE + 0.006, u)
    halfA.BackgroundTransparency = wTrans
    halfB.BackgroundTransparency = wTrans

    for i, s in ipairs(tearSeq) do
        if not tearDone[i] and u >= T_TEARSLASH + (i - 1) * 0.0075 then
            tearDone[i] = true
            spawnSlash(t, {
                parent = slashLayer,
                x1 = s.main and 0.5 or 0.35, x2 = s.main and 0.5 or 0.65,
                y1 = s.main and 0.5 or 0.35, y2 = s.main and 0.5 or 0.65,
                rot = s.rot, lenMul = 2.2, th = s.main and 6 or 4,
                c1 = s.c1, c2 = s.c2,
                life = math.max(T_OPEN2 * D - t, 0.8), drawT = 0.12, hold = 0.75,
            })
            burst = 14
        end
    end

    local g = 260 * sm(T_TEAR, T_TEAR + 0.025, u) + 2740 * sm(T_OPEN2, T_OFF, u)
    local wedge = 3 * sm(T_TEAR, T_TEAR + 0.025, u)
    local off = L / 2 + g / 2
    halfA.Position = UDim2.new(0.5, nx * off, 0.5, ny * off)
    halfB.Position = UDim2.new(0.5, -nx * off, 0.5, -ny * off)
    halfA.Rotation = TEAR_ANGLE + wedge
    halfB.Rotation = TEAR_ANGLE - wedge
    local edgeT = 1 - sm(T_TEAR, T_TEAR + 0.004, u)
    edgeA.BackgroundTransparency = edgeT
    edgeB.BackgroundTransparency = edgeT

    local ts = sm(T_TEAR + 0.005, T_TEAR + 0.025, u)
    if title:IsA("TextLabel") then
        title.TextTransparency = 1 - ts
        title.TextStrokeTransparency = 1 - 0.8 * ts
    else
        title.ImageTransparency = 1 - ts
    end
    titleScale.Scale = 1.25 - 0.25 * sm(T_TEAR, T_OFF, u)
    if domainScale then
        domainScale.Scale = 1.2 - 0.2 * sm(T_TEAR, T_END, u)
    end

    if u >= 0.83 and u < T_END - 0.005 and t - lastDomain > 1 / 9 then
        lastDomain = t
        domainCount += 1
        local black = domainCount % 3 == 0
        local life = rng:NextNumber(0.3, 0.5)
        spawnSlash(t, {
            parent = slashLayer, x1 = 0.03, x2 = 0.6, y1 = 0.1, y2 = 0.9,
            rot = rng:NextNumber(-60, 60), lenMul = rng:NextNumber(0.3, 0.6), th = 7,
            c1 = black and BLACK or RED, c2 = black and RED or WHITE,
            life = life, drawT = life / 3, hold = 0,
        })
        burst = math.max(burst, 8)
    end

    for i = #slashes, 1, -1 do
        local s = slashes[i]
        local age = (t - s.born) / s.life
        if age >= 1 then
            s.f:Destroy()
            table.remove(slashes, i)
        else
            local draw = ease(clamp01((t - s.born) / s.drawT))
            local fadeK = 0
            if age > s.hold then fadeK = (age - s.hold) / (1 - s.hold) end
            local curLen = s.len * draw
            s.f.Size = UDim2.fromOffset(curLen, s.th * (1 - fadeK) + 1)
            s.f.BackgroundTransparency = fadeK ^ 2
            if s.radial then
                local r = s.radial
                local d = r.r0 + curLen / 2
                s.f.Position = UDim2.new(r.cx, math.cos(r.ang) * d, r.cy, math.sin(r.ang) * d)
            end
        end
    end

    for _, s in ipairs(sides) do
        s.arcGrad.Rotation = (t * 360) % 360 * s.dir
        s.pct.Text = string.format("%d%%", math.floor(u * 100))
        s.fill.Size = UDim2.fromScale(1, u)
    end

    -- KHI HOÀN TẤT 100% INTRO
    if u >= 1 and not finished then
        finished = true
        conn:Disconnect()
        sound:Stop()
        gui:Destroy()
        
        -- Gọi script chính theo phân nhánh Game ID
        task.spawn(RunMainScript)
    end
end)

print("[Intro] khoi tao xong")
end)

if not __ok then
    warn("[Intro] LOI: " .. tostring(__err))
    task.spawn(RunMainScript)
end
