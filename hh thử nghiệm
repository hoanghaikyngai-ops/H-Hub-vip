local function buildGojo()
    local rig = newRig()
    local SKIN = Color3.fromRGB(255, 226, 205)
    local BLK  = Color3.fromRGB(16, 18, 30)
    local JKT  = Color3.fromRGB(26, 30, 52)
    local HAIR = Color3.fromRGB(245, 246, 255)

    for _, sx in ipairs({-0.85, 0.85}) do
        rig.add(mk(nil, V3(1.4, 4.2, 1.5), BLK), CFrame.new(sx, 2.1, 0))
    end
    rig.add(mk(nil, V3(3.5, 3.8, 1.9), JKT), CFrame.new(0, 6.0, 0))
    rig.add(mk(nil, V3(3.6, 0.5, 2.0), BLK), CFrame.new(0, 4.2, 0))
    rig.add(mk(nil, V3(3.2, 0.8, 2.1), BLK), CFrame.new(0, 8.0, 0))              -- cổ áo cao
    rig.add(mk(BALL, V3(2.6, 2.6, 2.6), SKIN), CFrame.new(0, 9.6, 0))           -- đầu
    rig.add(mk(nil, V3(2.7, 0.75, 2.7), BLK), CFrame.new(0, 9.8, 0))            -- băng che mắt
    for i = 1, 10 do                                                             -- tóc trắng dựng
        local a = i / 10 * math.pi * 2
        local pos = V3(math.cos(a) * 0.9, 10.9, math.sin(a) * 0.9)
        local dir = V3(math.cos(a) * 0.8, 1.3, math.sin(a) * 0.8)
        rig.add(mk(nil, V3(0.55, 0.55, 2.0), HAIR), CFrame.lookAt(pos, pos + dir))
    end
    for _ = 1, 4 do
        local pos = V3(rng:NextNumber(-0.4, 0.4), 11.2, rng:NextNumber(-0.4, 0.4))
        local dir = V3(rng:NextNumber(-0.3, 0.3), 1, rng:NextNumber(-0.3, 0.3))
        rig.add(mk(nil, V3(0.5, 0.5, 2.2), HAIR), CFrame.lookAt(pos, pos + dir))
    end
    for _, side in ipairs({-1, 1}) do
        local S = V3(side * 2.35, 7.5, 0)
        rig.add(mk(nil, V3(1.2, 3.4, 1.2), JKT), nil, {S = S, side = side, up = true, off = 1.7})
        rig.add(mk(nil, V3(1.0, 1.0, 1.0), SKIN), nil, {S = S, side = side, up = true, off = 3.7})
    end
    return rig
end

