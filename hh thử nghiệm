local function circle(scale, props, z)
    props.AnchorPoint = Vector2.new(0.5, 0.5)
    props.Position = UDim2.fromScale(0.5, 0.5)
    props.Size = UDim2.fromScale(scale, scale)
    props.BorderSizePixel = 0
